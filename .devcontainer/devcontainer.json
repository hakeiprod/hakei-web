{
  "name": "hakei-web",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/skriptfabrik/devcontainer-features/mailpit:1": {
      "version": "1.31.6"
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y --no-install-recommends python3 python3-venv openssh-client postgresql-client && python3 -m venv /opt/specify-tools && /opt/specify-tools/bin/pip install uv && UV_TOOL_BIN_DIR=/usr/local/bin /opt/specify-tools/bin/uv tool install specify-cli --python /usr/bin/python3 --from git+https://github.com/github/spec-kit.git@v1.1.3",
  "customizations": {
    "vscode": {
      "extensions": [
        "prisma.prisma",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "openai.chatgpt"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "eslint.useFlatConfig": true,
        "editor.guides.indentation": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.sortImports": "explicit"
        }
      }
    }
  },
  "workspaceFolder": "/workspaces/hakei-web",
  "forwardPorts": [
    3000,
    8025
  ],
  "portsAttributes": {
    "3000": {
      "label": "hakei-web",
      "onAutoForward": "notify"
    },
    "8025": {
      "label": "Mailpit",
      "onAutoForward": "notify"
    }
  },
  "image": "node:22-bookworm",
  "containerEnv": {
    "EMAIL_SERVER": "smtp://localhost:1025",
    "EMAIL_FROM": "hakei@example.invalid"
  }
}
